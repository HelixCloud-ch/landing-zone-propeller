# alb — one Application Load Balancer with IP target groups, listeners and rules.
# Copy to config.auto.tfvars (or supply via an overlay) and fill in.
region = "eu-central-2"
name   = "apps"

# Wired from the pipeline: vpc_id, subnet_ids, certificate_arns, target_ips_by_group.
vpc_id     = "vpc-0123456789abcdef0"
subnet_ids = ["subnet-0123456789abcdef0", "subnet-0fedcba9876543210"]

internal                     = true
create_security_group        = true
security_group_ingress_cidrs = ["10.0.0.0/8"]

# false so that sleep in destroy mode can delete the load balancer.
enable_deletion_protection = false

certificate_arns = {
  apps = "arn:aws:acm:eu-central-2:123456789012:certificate/00000000-0000-0000-0000-000000000000"
}

ip_target_groups = {
  router = {
    port     = 443
    protocol = "HTTPS"
    # No IPs here: they come from target_ips_by_group (pipeline input).
    health_check = {
      # Unknown hosts may answer 404 or 503. Pick one:
      #   matcher on the traffic port, or a dedicated health port.
      matcher = "200-499"
    }
  }
}

listeners = {
  https = {
    port             = 443
    protocol         = "HTTPS"
    certificate_keys = ["apps"]
    default_action = {
      type           = "fixed-response"
      fixed_response = { status_code = "404" }
    }
  }
  http = {
    port     = 80
    protocol = "HTTP"
    default_action = {
      type     = "redirect"
      redirect = { protocol = "HTTPS", port = "443" }
    }
  }
}

listener_rules = {
  apps = {
    listener_key = "https"
    priority     = 10
    conditions   = { host_headers = ["apps.example.com", "*.apps.example.com"] }
    action = {
      type             = "forward"
      target_group_key = "router"
    }
  }
  console = {
    listener_key = "https"
    priority     = 20
    conditions   = { host_headers = ["console.example.com"] }
    action = {
      type = "redirect"
      redirect = {
        status_code = "HTTP_302"
        host        = "console.apps.example.com"
      }
    }
  }
}
