region = "eu-central-2"

# ── CoreDNS ───────────────────────────────────────────────────────────────────
# On EC2 node-group clusters, EKS provides a working CoreDNS by default.
# Enable the managed add-on only to pin or upgrade the version.
install_coredns      = true
coredns_version      = "v1.11.4-eksbuild.40"
coredns_compute_type = null # EC2 nodes

# ── Base managed add-ons ──────────────────────────────────────────────────────
# Simple add-ons that need only a version pin. vpc-cni has its own project
# (eks-addon-vpc-cni) since it needs a dedicated IRSA role — it does not
# belong in this map.
base_addons = {
  kube-proxy = { enabled = true, version = "v1.32.0-eksbuild.2" }
  # Not needed until workloads or add-ons use Pod Identity.
  eks-pod-identity-agent = { enabled = false }
}

# cluster_name is injected by the pipeline from the eks-cluster project
# output — do NOT set it here.
