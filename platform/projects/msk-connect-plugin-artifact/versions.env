# Pinned artifact versions for the Debezium MSK Connect plugin build.
# No "latest" references: a connector upgrade must be a reviewable diff.

DEBEZIUM_VERSION=2.7.4.Final
# msk-config-providers: the GitHub release tag is r0.4.0 (the "r" prefix is
# not a typo; the v-prefixed tag scheme only starts at v0.5.0).
CONFIG_PROVIDERS_VERSION=0.4.0
OJDBC_VERSION=21.11.0.0

# Default download base URLs. These are the pinned public sources; a consumer
# may override any of them (via the matching PROPELLER_INPUT_*_url input) to
# point at an internal Maven mirror, a GitHub Enterprise host, or an internal
# copy of the license text — without editing this file.
MAVEN_CENTRAL_URL=https://repo1.maven.org/maven2
CONFIG_PROVIDERS_RELEASES_URL=https://github.com/aws-samples/msk-config-providers/releases/download
ORACLE_LICENSE_URL=https://www.oracle.com/downloads/licenses/oracle-free-license.html
