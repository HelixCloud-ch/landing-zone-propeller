set shell := ["bash", "-euo", "pipefail", "-c"]

# cdc-prepare-oracle: prepares an Oracle source database for Debezium CDC via
# LogMiner. Not a Terraform project; requires no state. Must run on an
# In_VPC_Runner (see README) so it can reach the database and Parameter
# Store. All environment-specific values arrive as PROPELLER_INPUT_* env vars
# — nothing about the host, user, parameter names, account or region is
# hardcoded.
#
# Unverified against real infrastructure. See README.md and
# docs/cdc-deployment-verification.md before any production use.

import "../../../shared/recipes/python.just"

_dir := justfile_directory()
_cdc_env := "../../shared/python/cdc"

# plan: report intent only. Reads PROPELLER_INPUT_* and echoes the host, the
# CDC user it would create, and the parameter NAMES it would read and write.
# It contacts nothing and modifies nothing. Credential VALUES are never
# echoed — only names and paths.
plan:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "cdc-prepare-oracle plan — intended actions (no changes made):"
    echo "  database host:            ${PROPELLER_INPUT_db_host:-<unset>}"
    echo "  database port:            ${PROPELLER_INPUT_db_port:-1521}"
    echo "  service name:             ${PROPELLER_INPUT_service_name:-<unset>}"
    echo "  pluggable database:       ${PROPELLER_INPUT_pdb_name:-<none: non-CDB>}"
    echo "  admin credential param:   ${PROPELLER_INPUT_admin_credential_parameter:-<unset>} (read)"
    echo "  admin username:           ${PROPELLER_INPUT_admin_username:-<from the parameter>}"
    echo "  CDC user to create:       ${PROPELLER_INPUT_cdc_username:-<unset>}"
    echo "  CDC username param:       ${PROPELLER_INPUT_cdc_username_parameter:-<unset>} (read if present; created if absent)"
    echo "  CDC password param:       ${PROPELLER_INPUT_cdc_password_parameter:-<unset>} (read if present; created if absent)"
    echo "  archivelog retention hrs: ${PROPELLER_INPUT_archivelog_retention_hours:-<unset>} (applied on every run)"
    echo "  KMS key id:               ${PROPELLER_INPUT_kms_key_id:-alias/aws/ssm}"
    echo "  preconditions to verify:  LOG_MODE=ARCHIVELOG, SUPPLEMENTAL_LOG_DATA_MIN, SUPPLEMENTAL_LOG_DATA_PK"

# apply: run prepare.py in the shared cdc python env (offline on the
# deploy-runner image, see shared/recipes/python.just).
apply: (py-run _cdc_env "python" "prepare.py")

# destroy: deliberate NO-OP. Dropping the CDC user is irreversible and is not
# the deployment's decision to make.
destroy:
    @echo "cdc-prepare-oracle destroy: no-op by design."
    @echo "  The CDC user is NOT dropped: dropping it is irreversible and is an"
    @echo "  operator decision, not the deployment's. Remove it manually if required."
