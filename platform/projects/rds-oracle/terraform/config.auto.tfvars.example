region         = "eu-central-2"
identifier     = "my-oracle-db"
engine_version = "19"  # Required. Use: aws rds describe-db-engine-versions --engine oracle-se2

# ── Engine ────────────────────────────────────────────────────────────────────
# engine         = "oracle-se2"        # Standard Edition Two (default)
# license_model  = "license-included"  # AWS provides the Oracle license
# instance_class = "db.t3.medium"      # t3 is burstable, m5 better for prod

# ── Storage ───────────────────────────────────────────────────────────────────
# allocated_storage     = 20    # Initial GiB
# max_allocated_storage = 40    # Autoscale up to this (0 = disable)
# storage_type          = "gp3"
# storage_encrypted     = true
# kms_key_id            = null  # Uses default aws/rds key

# ── Database ──────────────────────────────────────────────────────────────────
# db_name            = "ORCL"       # Oracle SID (uppercase, max 8 chars)
# character_set_name = "AL32UTF8"   # Cannot change after creation
# username           = "admin"      # Master user

# ── Credential strategy ───────────────────────────────────────────────────────
# Option 1: RDS-managed password (default — leave credential empty or set kms_key_id)
# credential = {}

# Option 2: Generate and store password in Secrets Manager
# credential = {
#   secret_name      = "platform/myapp/rds-oracle-master"
#   password_version = 1
#   kms_key_id       = "arn:aws:kms:eu-central-2:123456789012:key/abcd-1234"
#   password = {
#     length = 28
#   }
# }

# Option 3: Read existing secret from Secrets Manager
# credential = {
#   secret_arn = "arn:aws:secretsmanager:eu-central-2:123456789012:secret:my-db-AbCdEf"
# }

# Option 4: Generate and store in SSM Parameter Store
# credential = {
#   parameter_name   = "/platform/myapp/rds-oracle-master"
#   password_version = 1
# }

# Option 5: Read existing SSM parameter
# credential = {
#   parameter_arn = "arn:aws:ssm:eu-central-2:123456789012:parameter/platform/myapp/rds-oracle"
# }

# ── Network (from pipeline inputs) ───────────────────────────────────────────
# vpc_id and subnet_ids come from the Landing Zone via pipeline wiring.

# ── Access control ────────────────────────────────────────────────────────────
# allowed_cidrs              = [] # e.g. ["10.0.0.0/8"]
# allowed_security_group_ids = [] # e.g. ["sg-0123456789abcdef0"]

# ── Availability ──────────────────────────────────────────────────────────────
# multi_az = false

# ── Backups & Maintenance ─────────────────────────────────────────────────────
# backup_retention_period = 7
# backup_window           = "03:00-04:00"
# maintenance_window      = "sun:05:00-sun:06:00"

# ── Protection ────────────────────────────────────────────────────────────────
# deletion_protection = true   # Prevent accidental deletion
# skip_final_snapshot = false  # Take snapshot before deletion

# ── Upgrades ──────────────────────────────────────────────────────────────────
# auto_minor_version_upgrade = true
# apply_immediately          = false  # Wait for maintenance window

# ── Monitoring ────────────────────────────────────────────────────────────────
# performance_insights_enabled = false

# ── S3 Integration ────────────────────────────────────────────────────────────
# Creates an S3 bucket, IAM role, and option group for Oracle Data Pump.
# Bucket name: <identifier>-oracle-data-<account_id>-<region>-an
# enable_s3_integration = false
