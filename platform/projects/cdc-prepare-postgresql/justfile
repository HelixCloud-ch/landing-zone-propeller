set shell := ["bash", "-euo", "pipefail", "-c"]

# cdc-prepare-postgresql: prepares an RDS for PostgreSQL source database for
# Debezium CDC. Not a Terraform project; requires no state. Must run on an
# In_VPC_Runner (see README) so it can reach the database and Parameter Store.
# All environment-specific values arrive as PROPELLER_INPUT_* env vars — nothing
# about the host, user, parameter names, account or region is hardcoded.

import "../../../shared/recipes/python.just"

_dir := justfile_directory()
_cdc_env := "../../shared/python/cdc"

# plan: report intent only. Reads PROPELLER_INPUT_* and echoes the host, the
# CDC user it would create, and the parameter NAMES it would read and write.
# It contacts nothing and modifies nothing. Credential VALUES are never echoed —
# only names and paths.
plan:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "cdc-prepare-postgresql plan — intended actions (no changes made):"
    echo "  database host:            ${PROPELLER_INPUT_db_host:-<unset>}"
    echo "  database port:            ${PROPELLER_INPUT_db_port:-5432}"
    echo "  database name:            ${PROPELLER_INPUT_db_name:-<unset>}"
    echo "  SSL mode:                 ${PROPELLER_INPUT_ssl_mode:-require}"
    echo "  admin credential param:   ${PROPELLER_INPUT_admin_credential_parameter:-<unset>} (read)"
    echo "  admin username:           ${PROPELLER_INPUT_admin_username:-<from the parameter>}"
    echo "  CDC user to create:       ${PROPELLER_INPUT_cdc_username:-<unset>}"
    echo "  CDC username param:       ${PROPELLER_INPUT_cdc_username_parameter:-<unset>} (read if present; created if absent)"
    echo "  CDC password param:       ${PROPELLER_INPUT_cdc_password_parameter:-<unset>} (read if present; created if absent)"
    echo "  KMS key id:               ${PROPELLER_INPUT_kms_key_id:-alias/aws/ssm}"
    echo "  schemas granted:          ${PROPELLER_INPUT_schemas:-[\"public\"]}"
    echo "  manage publication:       ${PROPELLER_INPUT_manage_publication:-true}"
    echo "  publication name:         ${PROPELLER_INPUT_publication_name:-dbz_publication}"
    echo "  publication tables:       ${PROPELLER_INPUT_publication_tables:-<all tables>}"
    echo "  replication slot:         ${PROPELLER_INPUT_slot_name:-debezium} (reported only)"
    echo "  preconditions to verify:  wal_level=logical, a free replication slot, a usable slot if it exists, replica identity of published tables"

# apply: run prepare.py in the shared cdc python env (offline on the
# deploy-runner image, see shared/recipes/python.just).
apply: (py-run _cdc_env "python" "prepare.py")

# destroy: deliberate NO-OP. Dropping the CDC role, the publication or the
# replication slot is irreversible and is not the deployment's decision to make.
destroy:
    @echo "cdc-prepare-postgresql destroy: no-op by design."
    @echo "  The CDC role, the publication and the replication slot are NOT dropped."
    @echo "  An unread replication slot keeps WAL and can fill the instance storage."
    @echo "  After the connector is removed, drop the slot as an operator, and remove the"
    @echo "  connector offsets too:"
    @echo "    SELECT pg_drop_replication_slot('${PROPELLER_INPUT_slot_name:-debezium}');"

# ── Sleep and wake ────────────────────────────────────────────────────────────
# The autopilot calls `just sleep` / `just wake` with PROPELLER_SLEEP_MODE.
# apply-on-wake: sleep does nothing; wake runs apply again (idempotent), after
# the database and the Kafka cluster are back.
sleep:
    #!/usr/bin/env bash
    : "${PROPELLER_SLEEP_MODE:?PROPELLER_SLEEP_MODE required (declare an explicit mode in the sleep preset)}"
    just sleep-${PROPELLER_SLEEP_MODE}

wake:
    #!/usr/bin/env bash
    : "${PROPELLER_SLEEP_MODE:?PROPELLER_SLEEP_MODE required (declare an explicit mode in the sleep preset)}"
    just wake-${PROPELLER_SLEEP_MODE}

sleep-apply-on-wake:
    @echo "sleep-apply-on-wake: no-op"

wake-apply-on-wake: apply
